  m_Script: {fileID: 11500000, guid: 5fddde5166936c04b97d0a3810279faa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPopup
  popupPanel: {fileID: 2083901267}
  popupText: {fileID: 1203472322}
  steps:
  - "Welcome, agent. Something nasty is loose in Grandma Mary's computer, and you\u2019re our best shot."
  - <b>Mouse</b> = look around. Stay sharp. (Yes, the cats are watching.)
  - <b>Arrow keys</b> or <b>WASD</b> = move. Try not to knock anything off the desktop.
  - <b>Shift</b> when moving = sprint. For when a threat is urgent.
  - <b>E</b> = interact. Open doors, read notes, grab items. Anything that glows can be used, and some doors need a key.
  - <b>O</b> = minimize or maximize your objective list. Shrink it to keep your view clear.
  - <b>I</b> = inventory. Everything you pick up lands here.
  - '<b>H</b> = hint, <b>C</b> = clue about the threat, <b>Tab</b> = open the Assistant. Stuck? Just ask. '
  - <b>Esc</b> = pause menu. The Documentation tab explains every threat you meet.
  tutorialId: tutorial
  playOnStart: 1
  onlyOnce: 1
  freezeWhilePlaying: []
  onComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 274830146}
        m_TargetAssemblyTypeName: ObjectiveManager, Assembly-CSharp
        m_MethodName: Begin
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
